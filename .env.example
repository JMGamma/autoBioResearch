# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Anthropic Claude (required when llm_api_type: "anthropic") ---
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- Local LLM via OpenAI-compatible API (required when llm_api_type: "openai_compatible") ---
# Many local servers (Ollama, LM Studio, llama.cpp) accept any non-empty string.
LLM_API_KEY=none

# --- NCBI PubMed (optional: raises rate limit from 3 → 10 req/s) ---
# NCBI_API_KEY=your-ncbi-key-here

# --- Semantic Scholar (optional: avoids shared unauthenticated pool) ---
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key-here
